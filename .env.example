TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none

# Local decision engine (Apache-2.0, https://github.com/NandhaKishorM/laya).
# JEV_DECISION=laya routes operation/target choices to a local Laya checkpoint (no TypeSafe key needed);
# JEV_DECISION=typesafe (default) keeps the TypeSafe API.
JEV_DECISION=laya
JEV_LAYA_MODEL=C:/Users/witek/Documents/browseruse/models/laya-typed-decisions
JEV_LAYA_DEVICE=cuda
